# Database
DATABASE_URL="postgresql://draiver:draiver123@localhost:5432/draiver"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Maps API (Yandex Maps для Казахстана)
YANDEX_MAPS_API_KEY="your-yandex-maps-api-key"

# Payments Kaspi.kz
KASPI_API_KEY="your-kaspi-api-key"
KASPI_MERCHANT_ID="your-kaspi-merchant-id"
KASPI_CALLBACK_URL="https://your-domain.kz/api/payments/kaspi/callback"

# SMS Provider (SMSC.kz для Казахстана)
SMS_PROVIDER="smsc.kz"
SMS_LOGIN="your-smsc-login"
SMS_PASSWORD="your-smsc-password"
SMS_SENDER="Draiver"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="Draiver <noreply@draiver.kz>"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Logging
LOG_LEVEL="info"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket
SOCKET_CORS_ORIGIN="http://localhost:3000"
